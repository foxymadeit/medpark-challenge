SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=mom-bot@hospital.local
SMTP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

MOM_RECIPIENTS_MEDICAL=medical-board@hospital.local,admin-board@hospital.local
MOM_RECIPIENTS_EXECUTIVE=executive-board@hospital.local
MOM_RECIPIENTS_ADMINISTRATIVE=admin-board@hospital.local
# Liminal
LIMINAL_ADMIN_EMAIL=admin@medpark.local
LIMINAL_ADMIN_PASSWORD=
LIMINAL_DATA=./data
# LIMINAL_FRONTEND_DIST=../frontend/dist
# LIMINAL_SEND_WINDOW_S=60
# LIMINAL_AUTO_MODE=1
# LIMINAL_ROUTING=./routing.json
# LIMINAL_SECURE_COOKIES=1            # behind HTTPS
# LIMINAL_ALLOWED_ORIGINS=http://127.0.0.1:5173
# LIMINAL_N8N_WEBHOOK=                 # optional n8n in front of the mail step

# Pipeline stages (each in its own virtual environment)
# LIMINAL_ASR_CMD=/path/to/asr-llm/.venv/bin/python -m asr_llm.cli {audio} --skip-llm --out {work}/asr.json
# LIMINAL_ASR_CWD=/path/to/asr-llm
# LIMINAL_DIARIZE_CMD=/path/to/diarization/.venv/bin/diarizer file {audio} --out {work}/diarization --plain
# LIMINAL_MINUTES_CMD=/path/to/minutes/.venv/bin/mom report {work}/transcript.json --session {session} --type {type} --date {date} --start {start} --out {work}/minutes
