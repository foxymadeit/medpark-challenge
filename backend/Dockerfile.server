# The whole product in one image for the reference server: the web app, the
# backend and the three pipeline tools (transcription, speakers, minutes).
# Weights are not baked in: asr-llm/models is mounted read-only (compose.yaml),
# Ollama runs in its own container. Build from the repository root:
#   docker compose --profile server build        (GPU=0 for a CPU-only server)
FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ARG GPU=1
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
# texlive-fonts-recommended: pdfx needs ZapfDingbats for PDF/A
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg poppler-utils \
      texlive-xetex texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended \
      texlive-lang-european texlive-lang-cyrillic lmodern \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home liminal
WORKDIR /opt/liminal
COPY asr-llm asr-llm
COPY diarization diarization
COPY minutes minutes
COPY backend backend
RUN pip install -e 'asr-llm[asr]' -e diarization -e minutes "fastapi[standard]>=0.141.1" "python-dotenv>=1.0" \
    && if [ "$GPU" = "1" ]; then pip install nvidia-cublas-cu12 "nvidia-cudnn-cu12==9.*"; fi
# CTranslate2 finds cuBLAS and cuDNN from the pip wheels (harmless when GPU=0)
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib
COPY --from=web /web/dist /opt/liminal/frontend-dist
RUN mkdir -p /data && chown -R liminal /opt/liminal /data
ENV LIMINAL_FRONTEND_DIST=/opt/liminal/frontend-dist LIMINAL_DATA=/data
USER liminal
WORKDIR /opt/liminal/backend
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
